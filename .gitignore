# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
# dist contains the authored standalone web client and must be tracked.
__pycache__/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# Local snapshots of public faculty pages used for application research
/application/research/sources/

# 博士申请材料：套磁信主稿 / 导师定制稿、导师候选名单、申请策略与导师调研数据。
# 本仓库是公开的，这些内容一旦被 git add 就对外可见 —— 整目录排除，别逐条放。
/application/

# 本地临时探针与长流程测试产物：一次性的，抓完 4xx/5xx 与断言失败就丢，
# 留着只会让仓库凭空多出上百 KB 的日志。
scripts/_probe-*
scripts/_longflow-*.jsonl

# 对外的博士申请导览页（含申请意向与导师姓名输入），同样不进公开仓库。
# 首页指向它的链接已一并移除，避免留下死链。
/dist/research.html
/dist/research.js
/dist/research.css

# Portrait identity assets stay private. Generic large resources are distributed
# through GitHub Releases; restore with deploy/restore_runtime.py.
dist/narration/models/
dist/narration/background/
dist/narration/tour-male/
dist/fonts/
dist/assets/piano/salamander/

# Local deployment settings and authenticated browser sessions
/deploy/local.json
/deploy/private/
/services/suda-ds/.browser-profile*/
/services/suda-ds/.wvpn*/
/services/suda-ds/embedded_credentials.py

# Visitor-specific generated speech is private. Existing tracked files are unchanged.
/dist/narration/greetings/
